# ============================================================================
# Время отправки сообщений (UTC, опционально)
# ============================================================================
# Время отправки сообщений (UTC, формат HH:MM или HH)
# Поддерживается формат HH:MM (например, 20:30) или только HH (например, 7, автоматически преобразуется в 7:00)
# Время отправки утренних сообщений
MORNING_START=20:35
MORNING_END=20:45
# Время отправки вечерних сообщений
EVENING_START=23:50
EVENING_END=23:55

# ============================================================================
# Примеры для тестирования
# ============================================================================
# Для тестирования в любое время дня можно установить:
# MORNING_START=14
# MORNING_END=15
# EVENING_START=16
# EVENING_END=17

# =============================================================================
# Период демо режима
# =============================================================================
# Продолжительность бесплатного пробного периода для новых пар
# Минимальное значение: 1 день
# Максимальное значение: 365 дней
# По умолчанию: 7 дней (если не указано)
# Примеры:
#   TRIAL_PERIOD_DAYS=3   - короткий демо период (3 дня)
#   TRIAL_PERIOD_DAYS=7   - стандартный демо период (7 дней)
#   TRIAL_PERIOD_DAYS=14  - длинный демо период (14 дней)
#   TRIAL_PERIOD_DAYS=30  - очень длинный демо период (30 дней)
# После изменения значения необходимо перезапустить бота для применения изменений.
TRIAL_PERIOD_DAYS=7




# =============================================================================
# Silent Couple Bot 3.0 - Конфигурация
# =============================================================================
# Скопируйте этот файл в .env и заполните значениями для вашего окружения
# cp env.example .env

# =============================================================================
# Telegram Bot
# =============================================================================
TG_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Альтернативный токен бота для загрузки картинок (DEPRECATED - не используется)
# Оставлено для обратной совместимости, но все картинки теперь загружаются через основного бота
# TG_BOT_TOKEN_LOADER=789012:XYZ-GHI5678jkLmn-opq90R3w4x5y6z7ab

# =============================================================================
# Database
# =============================================================================
# БАЗА ДАННЫХ ДОЛЖНА БЫТЬ НА СЕРВЕРЕ (как и Redis)
# Бот автоматически создаст SSH туннель при запуске для подключения к БД на сервере
# 
# Настройка:
# 1. Укажите DATABASE_URL на localhost с портом (туннель будет создан автоматически):
#    Если PostgreSQL на сервере слушает на стандартном порту 5432:
DATABASE_URL=postgresql+asyncpg://bot_user:password@localhost:5432/silent_couple_bot
#    Если PostgreSQL на сервере слушает на нестандартном порту (например, 5433):
#DATABASE_URL=postgresql+asyncpg://bot_user:password@localhost:5433/silent_couple_bot
# 
# 2. Настройте SSH параметры для автоматического создания туннеля:
DATABASE_SSH_HOST=91.222.237.94          # IP или hostname VPS сервера с PostgreSQL
DATABASE_SSH_USER=root                   # SSH пользователь (по умолчанию: root)
DATABASE_SSH_PORT=22                     # SSH порт (по умолчанию: 22)
# 
# 3. Если PostgreSQL на сервере слушает на другом порту, чем указано в DATABASE_URL:
# DATABASE_REMOTE_PORT=5433                 # Порт PostgreSQL на сервере (если отличается от порта в DATABASE_URL)
#    Например, если DATABASE_URL указывает на localhost:5432, но на сервере PostgreSQL на 5433
# 
# ВАЖНО:
# - База данных должна быть установлена и настроена на сервере
# - PostgreSQL на сервере должен слушать на localhost (127.0.0.1) для безопасности
# - Бот автоматически создаст SSH туннель при запуске, если БД недоступна локально
# - Туннель автоматически закрывается при завершении работы бота
# - Для автоматического входа без пароля настройте SSH-ключи:
#   ssh-keygen -t rsa -b 4096
#   ssh-copy-id root@your-server-ip
# - Убедитесь, что локальный PostgreSQL на Windows НЕ запущен на том же порту,
#   что указан в DATABASE_URL, иначе туннель не создастся
# 
# Для разработки на разных ПК:
# - Скопируйте этот .env файл на каждый ПК
# - Убедитесь, что SSH ключи настроены на каждом ПК
# - Бот будет автоматически подключаться к БД на сервере через туннель

# =============================================================================
# Redis
# =============================================================================
# ВАРИАНТ 1: Локальный Redis (для разработки)
# REDIS_URL=redis://127.0.0.1:6379/0

# ВАРИАНТ 2: Прямое подключение к Redis на сервере
# Используйте этот вариант, если Redis слушает на внешнем IP сервера
# и порт 6379 открыт в firewall
# REDIS_URL=redis://your-server-ip:6379/0
# Пример:
# REDIS_URL=redis://91.222.237.94:6379/0

# ВАРИАНТ 3: Подключение через SSH туннель (рекомендуется для продакшена)
# Используйте этот вариант, если Redis слушает только на localhost сервера
# (127.0.0.1) и недоступен напрямую извне. Бот автоматически создаст
# SSH туннель при запуске, если Redis недоступен локально.
# 
# Настройка:
# 1. Укажите REDIS_URL на localhost (туннель будет создан автоматически):
REDIS_URL=redis://127.0.0.1:6379/0
# 
# 2. Настройте SSH параметры для автоматического создания туннеля:
REDIS_SSH_HOST=91.222.237.94          # IP или hostname VPS сервера с Redis
REDIS_SSH_USER=root                   # SSH пользователь (по умолчанию: root)
REDIS_SSH_PORT=22                     # SSH порт (по умолчанию: 22)
# 
# Примечания по SSH туннелю:
# - Для автоматического создания туннеля требуется SSH-клиент.
#   На Windows 10+ OpenSSH обычно уже установлен.
# - При первом подключении может потребоваться ввод пароля SSH.
# - Для автоматического входа без пароля настройте SSH-ключи:
#   ssh-keygen -t rsa -b 4096
#   ssh-copy-id root@your-server-ip
# - Туннель автоматически закрывается при завершении работы бота.
# - Если Redis уже доступен локально, туннель не создается.
# - Бот автоматически проверяет доступность Redis и создает туннель при необходимости.

# =============================================================================
# YooKassa Payment (DEPRECATED - закомментировано)
# =============================================================================
# YOOKASSA_SHOP_ID=123456
# YOOKASSA_SECRET_KEY=test_1234567890abcdef

# =============================================================================
# Robokassa Payment
# =============================================================================
# MerchantLogin - логин магазина в системе Robokassa
ROBOKASSA_MERCHANT_LOGIN=your_merchant_login

# Password #1 - используется для генерации подписи при создании ссылки на оплату
ROBOKASSA_PASSWORD_1=your_password_1

# Password #2 - используется для проверки подписи в ResultURL (webhook)
ROBOKASSA_PASSWORD_2=your_password_2

# Использовать продакшн режим (True) или тестовый (False)
# В тестовом режиме используйте тестовые пароли из личного кабинета Robokassa
ROBOKASSA_IS_PRODUCTION=false

# Домен Робокассы (по умолчанию: robokassa.ru)
# Варианты: robokassa.ru (Россия), robokassa.kz (Казахстан), robokassa.com (международный)
# Используйте тот домен, который указан в вашем личном кабинете Robokassa
# Если не указано, будет использован robokassa.ru
# ROBOKASSA_DOMAIN=robokassa.ru

# Включать ли Shp_ параметры в подпись (по умолчанию: true).
# Для диагностики 500 можно временно отключить подпись Shp_ (оставив их только в URL).
# ROBOKASSA_INCLUDE_SHP_IN_SIGNATURE=true

# Разделитель между ключом и значением Shp_ в подписи:
# - стандартно: '='  (Shp_key=value)
# - альтернативно: ':' (Shp_key:value)
# Допустимые значения: '=' или ':'
# Примеры:
# ROBOKASSA_SHP_KV_SEPARATOR==      # значение '='
# ROBOKASSA_SHP_KV_SEPARATOR=:      # значение ':'

# =============================================================================
# Цены подписок (JSON формат)
# =============================================================================
# ВАЖНО: Указывайте ТОЛЬКО цены в рублях (RUB)!
# Цены для других валют рассчитываются автоматически с учетом маржи и курсов валют
# Формат: {"RUB": {"plan_id": price, ...}}
# Цены указываются в основных единицах валюты (не копейки/центы)
# ВАЖНО: JSON должен быть в одну строку (без переносов строк внутри)
# Пример:
SUBSCRIPTION_PRICES={"RUB": {"1_month": 299, "3_months": 799, "6_months": 1399, "1_year": 2499, "lifetime": 4999}}

# Процент маржи для валют (добавляется к курсу обмена)
# Пример: 17 означает +17% маржи (цена = RUB_цена * курс * 1.17)
CURRENCY_MARGIN_PERCENT=17.0

# Фиксированные курсы обмена валют от RUB (JSON формат)
# Формат: {"CURRENCY": rate, ...}
# Курс означает: 1 RUB = rate * CURRENCY
# Пример: {"USD": 0.010} означает 1 RUB = 0.010 USD
# Если валюта не указана, используются приблизительные курсы
# ВАЖНО: JSON должен быть в одну строку (без переносов строк внутри)
# ПРИМЕЧАНИЕ: Эти курсы используются как fallback, если не удалось получить актуальные курсы от ЦБ РФ
CURRENCY_EXCHANGE_RATES={"USD": 0.010, "EUR": 0.009, "UAH": 0.40, "BYN": 0.033, "KZT": 4.5, "AED": 0.037, "THB": 0.36, "TRY": 0.32, "CNY": 0.072}

# Время жизни кеша курсов валют в минутах (по умолчанию: 30 минут)
# Курсы валют получаются от ЦБ РФ API и кешируются в Redis
# Рекомендуется: 30-60 минут для баланса между актуальностью и нагрузкой на API
CURRENCY_RATES_CACHE_TTL_MINUTES=30

# =============================================================================
# MinIO Object Storage
# =============================================================================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123

# =============================================================================
# Environment & Logging
# =============================================================================
ENVIRONMENT=dev
LOG_LEVEL=INFO

# Путь к файлу логов (относительно корня проекта)
# Оставьте пустым или не указывайте, чтобы отключить логирование в файл
# Логи всегда выводятся в консоль (PowerShell)
LOG_FILE=logs/bot.log

# Максимальный размер файла лога перед ротацией (в байтах)
# По умолчанию: 10 МБ (10 * 1024 * 1024)
LOG_FILE_MAX_BYTES=10485760

# Количество резервных файлов логов для хранения
# По умолчанию: 5 (будет храниться bot.log, bot.log.1, bot.log.2, ..., bot.log.5)
LOG_FILE_BACKUP_COUNT=5

# =============================================================================
# Mini App URL
# =============================================================================
MINI_APP_URL=http://localhost:8000

# =============================================================================
# Telegram Bot Webhook (optional, for production)
# =============================================================================
# =============================================================================
# Telegram Bot Webhook (для production на сервере)
# =============================================================================
# ВНИМАНИЕ: Эти настройки закомментированы для локальной разработки
# Раскомментируйте их только при деплое на сервер для production
#
# Если WEBHOOK_URL установлен, бот будет использовать webhook вместо polling
# Формат: https://your-domain.com/webhook/telegram
# Для домена 24policybot.ru:
# WEBHOOK_URL=https://24policybot.ru/webhook/telegram
# WEBHOOK_PATH=/webhook/telegram
# WEBHOOK_PORT=8443
# Секретный токен для защиты webhook (рекомендуется)
# Сгенерируйте случайную строку: openssl rand -hex 32
# WEBHOOK_SECRET_TOKEN=your-secret-token-here

# =============================================================================
# Admin
# =============================================================================
# Telegram ID администратора для команд разработки (например, /admin, /reset_demo)
ADMIN_TG_ID=123456789

# =============================================================================
# Время отправки сообщений (локальное время пользователя)
# =============================================================================
# Поддерживается формат HH:MM (например, 20:30) или только HH (например, 7, автоматически преобразуется в 7:00)
# ВАЖНО: Указывайте желаемое локальное время для пользователей!
# Бот автоматически учитывает часовой пояс каждого пользователя (utc_offset)
# Примеры:
#   MORNING_START=7:00  - сообщения будут отправляться в 7:00 по местному времени каждого пользователя
#   EVENING_START=21:15 - сообщения будут отправляться в 21:15 по местному времени каждого пользователя
# Если пользователи в паре находятся в разных часовых поясах, сообщение отправляется,
# когда хотя бы один из них находится в указанном временном окне
MORNING_START=7:00
MORNING_END=8:00
EVENING_START=21:00
EVENING_END=22:00

# =============================================================================
# Timezone detection (НЕ РЕКОМЕНДУЕТСЯ для webhook)
# =============================================================================
# Авто-определение часового пояса по IP.
# В Telegram webhook режиме IP запроса чаще всего принадлежит серверам Telegram,
# а не пользователю — из-за этого utc_offset может установиться неверно.
# Рекомендуется оставить выключенным и задавать часовой пояс вручную (по умолчанию UTC+3).
TIMEZONE_DETECT_FROM_IP_ENABLED=false

# =============================================================================
# Период демо режима
# =============================================================================
# Продолжительность бесплатного пробного периода для новых пар
# Минимальное значение: 1 день
# Максимальное значение: 365 дней
# По умолчанию: 7 дней (если не указано)
# Примеры:
#   TRIAL_PERIOD_DAYS=3   - короткий демо период (3 дня)
#   TRIAL_PERIOD_DAYS=7   - стандартный демо период (7 дней)
#   TRIAL_PERIOD_DAYS=14  - длинный демо период (14 дней)
#   TRIAL_PERIOD_DAYS=30  - очень длинный демо период (30 дней)
# После изменения значения необходимо перезапустить бота для применения изменений.
TRIAL_PERIOD_DAYS=7

# =============================================================================
# Redis ключи и настройки напоминаний
# =============================================================================
# Префиксы для ключей Redis (используются для отслеживания отправленных напоминаний и предупреждений)
# Изменяйте только если нужно избежать конфликтов с другими приложениями
REDIS_KEY_PREFIX_REMINDER_SENT=reminder_sent
REDIS_KEY_PREFIX_WARNING_CANCELLED=initiator_warning_cancelled
REDIS_KEY_PREFIX_WARNING_LAST_TIME=initiator_warning_last_time
REDIS_KEY_PREFIX_TASK_LOCK=task_lock

# Настройки напоминаний получателю
# Часы после отправки картинки, когда нужно отправить напоминание (через запятую)
# Пример: 3,6,9 означает напоминания через 3, 6 и 9 часов после отправки
REMINDER_HOURS=3,6,9

# Время жизни ключей напоминаний в Redis (в часах)
# После этого времени напоминание может быть отправлено снова
REMINDER_TTL_HOURS=24

# Настройки предупреждений инициатору
# Минимальное количество часов после отправки картинки перед отправкой первого предупреждения
WARNING_MIN_HOURS=10

# Интервал между предупреждениями (в часах)
# Предупреждения будут отправляться не чаще указанного интервала
WARNING_INTERVAL_HOURS=6

# Время жизни ключей предупреждений в Redis (в днях)
# После этого времени предупреждение может быть отправлено снова
WARNING_TTL_DAYS=7

# Настройки блокировок задач
# Время жизни блокировок задач в Redis (в секундах)
# Используется для предотвращения одновременного выполнения одной и той же задачи
TASK_LOCK_TTL_SECONDS=60

# Настройки других уведомлений
# Время жизни ключей напоминаний о поделиться ботом (в часах)
NUDGE_TTL_HOURS=24

# Время жизни ключей еженедельных сводок (в днях)
SUMMARY_TTL_DAYS=7

# =============================================================================
# Настройки уведомлений о продлении подписки
# =============================================================================
# Количество дней до окончания подписки, когда нужно начать отправлять уведомления
# Минимальное значение: 1 день
# Максимальное значение: 30 дней
# По умолчанию: 3 дня
# Примеры:
#   SUBSCRIPTION_RENEWAL_DAYS_BEFORE=1   - уведомления за 1 день до окончания
#   SUBSCRIPTION_RENEWAL_DAYS_BEFORE=3   - уведомления за 3 дня до окончания (рекомендуется)
#   SUBSCRIPTION_RENEWAL_DAYS_BEFORE=7   - уведомления за неделю до окончания
SUBSCRIPTION_RENEWAL_DAYS_BEFORE=3

# Интервал между уведомлениями о продлении подписки (в часах)
# Уведомления будут отправляться не чаще указанного интервала
# Минимальное значение: 1 час
# Максимальное значение: 24 часа
# По умолчанию: 6 часов
# Примеры:
#   SUBSCRIPTION_RENEWAL_REMINDER_INTERVAL_HOURS=3   - каждые 3 часа
#   SUBSCRIPTION_RENEWAL_REMINDER_INTERVAL_HOURS=6   - каждые 6 часов (рекомендуется)
#   SUBSCRIPTION_RENEWAL_REMINDER_INTERVAL_HOURS=12  - каждые 12 часов
SUBSCRIPTION_RENEWAL_REMINDER_INTERVAL_HOURS=6

# Префикс для ключей Redis (используется для отслеживания отправленных уведомлений о продлении)
# Изменяйте только если нужно избежать конфликтов с другими приложениями
REDIS_KEY_PREFIX_RENEWAL_REMINDER=renewal_reminder_sent

# =============================================================================
# Feedback / Support Tickets
# =============================================================================

# Префикс для ключей Redis (используется для отслеживания активных тикетов обратной связи)
# Изменяйте только если нужно избежать конфликтов с другими приложениями
REDIS_KEY_PREFIX_FEEDBACK_TICKET=feedback_ticket

# Время жизни тикета обратной связи в часах (по умолчанию: 72 часа)
# Через это время тикет считается закрытым, новое сообщение = новый тикет
FEEDBACK_TICKET_TTL_HOURS=72

# =============================================================================
# Сведения о боте (для отображения в меню пользователя)
# =============================================================================
# Эти данные будут отображаться в пункте меню "ℹ️ Сведения о боте"
# 
# ВАЖНО:
# - Если какая-то информация не актуальна (например, ЕГРИП или ОГРН),
#   просто закомментируйте соответствующую строку (добавьте # в начало)
# - При изменении формы собственности можно раскомментировать нужные строки
# - Закомментированные поля не будут отображаться в боте
# - Все поля опциональны, но рекомендуется заполнить хотя бы ИНН и контакты
#
# Примеры использования:
# 1. Для ИП (Индивидуальный предприниматель):
#    RESOURCE_INN=123456789012
#    RESOURCE_STATUS=ИП
#    RESOURCE_EGRIP=123456789012345
#    # RESOURCE_OGRN=  (закомментировано, т.к. не применимо для ИП)
#
# 2. Для ООО (Общество с ограниченной ответственностью):
#    RESOURCE_INN=123456789012
#    RESOURCE_STATUS=ООО
#    RESOURCE_OGRN=1234567890123
#    # RESOURCE_EGRIP=  (закомментировано, т.к. не применимо для ООО)
#
# 3. Для самозанятого:
#    RESOURCE_INN=123456789012
#    RESOURCE_STATUS=Самозанятый
#    # RESOURCE_OGRN=  (закомментировано)
#    # RESOURCE_EGRIP=  (закомментировано)

# ИНН (обязательно для ИП и организаций)
# Формат: 10 цифр для организаций, 12 цифр для ИП
RESOURCE_INN=123456789012

# Статус (форма собственности)
# Примеры: ИП, Самозанятый, ООО, АО, ПАО и т.д.
RESOURCE_STATUS=ИП

# ОГРН (Основной государственный регистрационный номер)
# Используется для организаций (ООО, АО и т.д.)
# Для ИП не используется (используется ЕГРИП)
# Закомментируйте эту строку, если не применимо
# RESOURCE_OGRN=1234567890123

# ЕГРИП (Единый государственный реестр индивидуальных предпринимателей)
# Используется для ИП (Индивидуальных предпринимателей)
# Для организаций не используется (используется ОГРН)
# Закомментируйте эту строку, если не применимо
# RESOURCE_EGRIP=123456789012345

# Email для связи
# Будет отображаться в информации о боте
RESOURCE_EMAIL=support@example.com

# Телефон для связи
# Будет отображаться в информации о боте
# Рекомендуется указывать в формате: +7 (999) 123-45-67
RESOURCE_PHONE=+7 (999) 123-45-67

# ============================================================================
# Silent Couple Bot 3.0 - Environment Variables
# ============================================================================
# Скопируйте этот файл в .env и заполните реальными значениями
# cp .env.example .env

# ============================================================================
# Telegram Bot (ОБЯЗАТЕЛЬНО)
# ============================================================================
# Токен бота от @BotFather
TG_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# ============================================================================
# Database (ОБЯЗАТЕЛЬНО)
# ============================================================================
# Строка подключения к PostgreSQL
# Формат: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://bot_user:password@localhost:5432/silent_couple_bot

# ============================================================================
# Redis (опционально, есть значения по умолчанию)
# ============================================================================
# URL подключения к Redis (для FSM storage и rate limiting)
REDIS_URL=redis://localhost:6379/0
# Номер базы данных Redis (по умолчанию 0)
REDIS_DB=0

# ============================================================================
# YooKassa Payment (ОБЯЗАТЕЛЬНО для продакшена)
# ============================================================================
# ID магазина в YooKassa
YOOKASSA_SHOP_ID=123456
# Секретный ключ YooKassa
# Для тестирования используйте test_* ключи
YOOKASSA_SECRET_KEY=test_1234567890abcdef

# ============================================================================
# MinIO / S3 Object Storage (ОБЯЗАТЕЛЬНО)
# ============================================================================
# Endpoint MinIO (host:port)
MINIO_ENDPOINT=localhost:9000
# Access Key для MinIO
MINIO_ACCESS_KEY=minioadmin
# Secret Key для MinIO
MINIO_SECRET_KEY=minioadmin123
# Имя bucket для картинок (по умолчанию: pics)
MINIO_BUCKET_PICS=pics

# ============================================================================
# Environment & Logging (опционально)
# ============================================================================
# Окружение: dev, staging, prod
ENVIRONMENT=dev
# Уровень логирования: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ============================================================================
# Mini App (опционально, есть значение по умолчанию)
# ============================================================================
# URL для Telegram Mini App
# В продакшене должен быть HTTPS
MINI_APP_URL=http://localhost:8000

# ============================================================================
# Admin (опционально, для разработки)
# ============================================================================
# Telegram ID администратора для команд /reset_demo
# Получить свой ID можно через @userinfobot
# Оставьте пустым или не указывайте, если не нужны админ команды
ADMIN_TG_ID=

# ============================================================================
# Время отправки сообщений (UTC, опционально)
# ============================================================================
# Время отправки утренних сообщений (часы 0-23 UTC)
# По умолчанию: 07:00-08:00 UTC
MORNING_START=7
MORNING_END=8

# Время отправки вечерних сообщений (часы 0-23 UTC)
# По умолчанию: 21:00-22:00 UTC
EVENING_START=21
EVENING_END=22

# ============================================================================
# Примеры для тестирования
# ============================================================================
# Для тестирования в любое время дня можно установить:
# MORNING_START=14
# MORNING_END=15
# EVENING_START=16
# EVENING_END=17
